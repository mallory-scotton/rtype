{
  "configurations": [
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/Engine/Source",
        "${workspaceFolder}/Engine/Tests",
        "${workspaceFolder}/Game/Source",
        "~/.conan2/p/b/**/p/include",
        "/root/.conan2/p/b/**/p/include",
        "/usr/include/**"
      ],
      "defines": [
        "ASIO_STANDALONE",
        "TKD_ENGINE_WITH_GRAPHICS"
      ],
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "linux-gcc-x64",
      "compileCommands": "${workspaceFolder}/Build/compile_commands.json",
      "configurationProvider": "ms-vscode.cmake-tools"
    }
  ],
  "version": 4
}
