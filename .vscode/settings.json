{
  /* C++ Formatting */
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.clang_format_fallbackStyle": "LLVM",
  "C_Cpp.autoAddFileAssociations": false,

  /* Language Specific Configuration */
  "[cpp]": {
    "editor.tabSize": 4,
    "prettier.useTabs": false,
    "editor.rulers": [79],
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.tabSize": 4,
    "prettier.useTabs": false,
    "editor.rulers": [79]
  },
  "[makefile]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": false,
    "editor.rulers": [79]
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.tabSize": 2
  },
  "[jsonl]": {
    "editor.tabSize": 2
  },

  /* Epitech Header Generator */
  "epitech-c-cpp-headers.headerType": "post2017",
  "epitech-c-cpp-headers.usePragmaOnce": true,
  "epitech-c-cpp-headers.autoGenerateClasses": false,
  "epitech-c-cpp-headers.indentAccessSpecifiers": false,

  /* Better Comment Settings */
  "better-comments.tags": [
    {
      "tag": "!",
      "color": "#FF2D00",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "?",
      "color": "#3498DB",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "todo",
      "color": "#FF8C00",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "*",
      "color": "#98C379",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    }
  ],

  /* IDE Settings */
  "editor.minimap.enabled": false,
  "explorer.compactFolders": false,

  /* C++ IntelliSense Settings */
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.errorSquiggles": "enabled",
  "C_Cpp.autocomplete": "default",
  "C_Cpp.suggestSnippets": true,
  "cmake.configureOnOpen": false,
  "cmake.buildDirectory": "${workspaceFolder}/Build",

  /* Prettier default configuration */
  "prettier.printWidth": 120,
  "prettier.tabWidth": 2,
  "prettier.useTabs": false,
  "prettier.semi": true,
  "prettier.singleQuote": true,
  "prettier.jsxSingleQuote": true,
  "prettier.trailingComma": "none",
  "prettier.bracketSpacing": true,
  "prettier.bracketSameLine": false,
  "prettier.arrowParens": "always",
  "prettier.insertPragma": false,
  "prettier.proseWrap": "preserve",
  "prettier.quoteProps": "consistent",
  "prettier.htmlWhitespaceSensitivity": "css",
  "prettier.endOfLine": "crlf",

  /* Language specific configuration */
  "[typescript]": {
    "editor.tabSize": 2,
    "prettier.useTabs": false,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": true
  },
  "[typescriptreact]": {
    "editor.tabSize": 2,
    "prettier.useTabs": false,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": true
  },
  "[javascript]": {
    "editor.tabSize": 2,
    "prettier.useTabs": false,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": true
  },
  "[javascriptreact]": {
    "editor.tabSize": 2,
    "prettier.useTabs": false,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.insertFinalNewline": false,
    "files.trimFinalNewlines": true
  }
}
