#!/bin/bash

# Get list of staged C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|h|inl)$' || true)

# Check if we have any files to process
if [ -z "$STAGED_FILES" ]; then
    echo "No C++ files staged for commit"
    exit 0
fi

echo "Formatting staged C++ files..."
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        echo "  Formatting: $file"
        clang-format -i "$file"
        git add "$file"
    fi
done

echo "✓ All C++ files formatted successfully"
exit 0
